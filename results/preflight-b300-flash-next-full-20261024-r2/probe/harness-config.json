{
  "$schema": "https://opencode.ai/config.json",
  "model": "strix/qwen3.8-flash-next",
  "small_model": "strix/qwen3.8-flash-next",
  "enabled_providers": [
    "strix"
  ],
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "*": "allow",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "provider": {
    "strix": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strix benchmark",
      "options": {
        "baseURL": "http://127.0.0.1:18080/v1",
        "apiKey": "local",
        "timeout": 600000
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "qwen3.8-flash-next",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}
