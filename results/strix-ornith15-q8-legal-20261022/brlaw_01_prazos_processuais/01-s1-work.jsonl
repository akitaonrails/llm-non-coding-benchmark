 data de publicação, quando a intimação se der pelo Diário da Justiça impresso ou eletrônico."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/work/workspace/library/cpc_prazos.md\"}"},"time":{"start":1792710370960,"end":1792710370977}}}}
