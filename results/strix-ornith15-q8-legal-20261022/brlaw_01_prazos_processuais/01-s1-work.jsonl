{"type":"tool_use","timestamp":1792711045676,"sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","part":{"partID":"prt_165e7b224001HSNeUeVSuO0Hoe","sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","messageID":"msg_165e75263001QctUl4WZQTHv9f","type":"tool","id":"W0wdUENxPA5h6uT1wDDZe83oRfIstcUD","tool":"write","state":{"status":"completed","input":{"content":"import datetime\n\ndef wd(d):\n    return d.strftime(\"%A %d/%m\")\n\nNONBUS = {\n    datetime.date(2026, 10, 28),  # dia do Servidor Público — sem expediente forense\n    datetime.date(2026, 12, 24),  # sem expediente forense\n    datetime.date(2026, 12, 31),  # sem expediente forense\n}\nRECESS = (datetime.date(2026, 12, 20), datetime.date(2027, 1, 20))  # inclusive\n\n\ndef is_bday(d):\n    return not (d.weekday() >= 5\n                or d in NONBUS\n                or RECESS[0] <= d <= RECESS[1])\n\n\ndef first_business_after(day):\n    n = day + datetime.timedelta(days=1)\n    while not is_bday(n):\n        n += datetime.timedelta(days=1)\n    return n\n\n\ndef add_bdays(start_exclusive, n):\n    d = start_exclusive\n    seq = []\n    while len(seq) < n:\n        d += datetime.timedelta(days=1)\n        if is_bday(d):\n            seq.append(d)\n    return d, seq\n\n\n# ===== CITACAO -> contestacao (15 dias uteis) =====\ncit_dispon = datetime.date(2026, 10, 19)  # Thu\ncit_pub = cit_dispon                        # already useful\ncit_inicio = first_business_after(cit_pub)\nv_cit, seq_cit = add_bdays(cit_inicio, 15)\n\nprint(\"=== CITACAO -> contestacao (art. 335 III = 15 dias uteis) ===\")\nprint(\"publicacao (art. 4 3; CPC 224 2):\", wd(cit_pub))\nprint(\"inicio contagem (art. 224 3; 231 VII):\", wd(cit_inicio))\nprint(\"contagem:\", [wd(x) for x in seq_cit])\nprint(\"VENCIMENTO =\", wd(v_cit), \"\\n\")\n\n# ===== SENTENCA -> recurso (15 dias uteis) =====\nsent_dispon = datetime.date(2026, 12, 10)  # Thu\nsent_pub = sent_dispon\nsent_inicio = first_business_after(sent_pub)\nv_sent, seq_sent = add_bdays(sent_inicio, 15)\n\nprint(\"=== SENTENCA -> recurso (art. 1.003 5 = 15 dias uteis) ===\")\nprint(\"publicacao:\", wd(sent_pub))\nprint(\"inicio contagem:\", wd(sent_inicio))\nfor x in seq_sent:\n    tag = \"\"\n    if RECESS[0] <= x <= RECESS[1]:\n        tag = \"  (dentro do RECESSO art. 220)\"\n    if x in NONBUS:\n        tag = \"  (sem expediente)\"\n    print(\"  \" + wd(x) + tag)\nprint(\"VENCIMENTO =\", wd(v_sent))\nprint()\n\n# ===== Sentenca -> embargos 5 dias uteis (opcional) =====\nv_emb, seq_emb = add_bdays(sent_inicio, 5)\nprint(\"=== SENTENCA -> embargos (art. 1.023 = 5 dias uteis) ===\")\nprint(\"contagem:\", [wd(x) for x in seq_emb])\nprint(\"VENCIMENTO =\", wd(v_emb))\n","path":"/tmp/calc.py"},"output":"Created file successfully: /tmp/calc.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/calc.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import datetime\\n\\ndef wd(d):\\n    return d.strftime(\\\"%A %d/%m\\\")\\n\\nNONBUS = {\\n    datetime.date(2026, 10, 28),  # dia do Servidor Público — sem expediente forense\\n    datetime.date(2026, 12, 24),  # sem expediente forense\\n    datetime.date(2026, 12, 31),  # sem expediente forense\\n}\\nRECESS = (datetime.date(2026, 12, 20), datetime.date(2027, 1, 20))  # inclusive\\n\\n\\ndef is_bday(d):\\n    return not (d.weekday() \\u003e= 5\\n                or d in NONBUS\\n                or RECESS[0] \\u003c= d \\u003c= RECESS[1])\\n\\n\\ndef first_business_after(day):\\n    n = day + datetime.timedelta(days=1)\\n    while not is_bday(n):\\n        n += datetime.timedelta(days=1)\\n    return n\\n\\n\\ndef add_bdays(start_exclusive, n):\\n    d = start_exclusive\\n    seq = []\\n    while len(seq) \\u003c n:\\n        d += datetime.timedelta(days=1)\\n        if is_bday(d):\\n            seq.append(d)\\n    return d, seq\\n\\n\\n# ===== CITACAO -\\u003e contestacao (15 dias uteis) =====\\ncit_dispon = datetime.date(2026, 10, 19)  # Thu\\ncit_pub = cit_dispon                        # already useful\\ncit_inicio = first_business_after(cit_pub)\\nv_cit, seq_cit = add_bdays(cit_inicio, 15)\\n\\nprint(\\\"=== CITACAO -\\u003e contestacao (art. 335 III = 15 dias uteis) ===\\\")\\nprint(\\\"publicacao (art. 4 3; CPC 224 2):\\\", wd(cit_pub))\\nprint(\\\"inicio contagem (art. 224 3; 231 VII):\\\", wd(cit_inicio))\\nprint(\\\"contagem:\\\", [wd(x) for x in seq_cit])\\nprint(\\\"VENCIMENTO =\\\", wd(v_cit), \\\"\\\\n\\\")\\n\\n# ===== SENTENCA -\\u003e recurso (15 dias uteis) =====\\nsent_dispon = datetime.date(2026, 12, 10)  # Thu\\nsent_pub = sent_dispon\\nsent_inicio = first_business_after(sent_pub)\\nv_sent, seq_sent = add_bdays(sent_inicio, 15)\\n\\nprint(\\\"=== SENTENCA -\\u003e recurso (art. 1.003 5 = 15 dias uteis) ===\\\")\\nprint(\\\"publicacao:\\\", wd(sent_pub))\\nprint(\\\"inicio contagem:\\\", wd(sent_inicio))\\nfor x in seq_sent:\\n    tag = \\\"\\\"\\n    if RECESS[0] \\u003c= x \\u003c= RECESS[1]:\\n        tag = \\\"  (dentro do RECESSO art. 220)\\\"\\n    if x in NONBUS:\\n        tag = \\\"  (sem expediente)\\\"\\n    print(\\\"  \\\" + wd(x) + tag)\\nprint(\\\"VENCIMENTO =\\\", wd(v_sent))\\nprint()\\n\\n# ===== Sentenca -\\u003e embargos 5 dias uteis (opcional) =====\\nv_emb, seq_emb = add_bdays(sent_inicio, 5)\\nprint(\\\"=== SENTENCA -\\u003e embargos (art. 1.023 = 5 dias uteis) ===\\\")\\nprint(\\\"contagem:\\\", [wd(x) for x in seq_emb])\\nprint(\\\"VENCIMENTO =\\\", wd(v_emb))\\n\",\"path\":\"/tmp/calc.py\"}"},"time":{"start":1792711045668,"end":1792711045676}}}}
