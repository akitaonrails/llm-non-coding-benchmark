{"type":"tool_use","timestamp":1792712175123,"sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","part":{"partID":"prt_165f8ee0c001TTSjx2F31c946x","sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","messageID":"msg_165f4f716001zdAkkkGsrp5uLj","type":"tool","id":"0u7gCuMENrJul7UWEDUCuaXdM5mLPo4L","tool":"write","state":{"status":"completed","input":{"content":"import datetime\n\ndef wd(d):\n    return f\"{d:%d.%m.%Y} ({d:%a[:3]})\"\n\n# ---- Calendar facts (library/calendario_forense_campinas.md) ----\n# 20/11/2026 (sex) = Dia Nacional de Zumbi e Consciência Negra (Lei 14.759/2023)  -> holiday\n# 24/12, 31/12, 01/01 = sem expediente forense (no recesso; 25/12 Natal, 02/01? )\n# Recessao (art. 220): 20/12/2026 .. 20/01/2027 inclusive\nFERIADOS = {\n    datetime.date(2026, 11, 20),  # Dia Nacional de Zumbi (Lei 14.759/2023)\n    datetime.date(2026, 11, 28),  # Dia do ServidoPublico\n    datetime.date(2026, 12, 25),  # Natal\n}\nSEM_EXPEDIENTE = {  # sem expediente forense, fora do recessao\n    datetime.date(2026, 12, 24),\n    datetime.date(2026, 12, 31),\n}\n\nRECESSAO_IN, RECESSAO_FIM = datetime.date(2026, 12, 20), datetime.date(2027, 1, 20)\n\n\ndef is_bday(d):\n    if d.weekday() >= 5:\n        return False\n    if d in FERIADOS or d in SEM_EXPEDIENTE:\n        return False\n    if RECESSAO_IN <= d <= RECESSAO_FIM:  # recessao suspende (art. 220)\n        return False\n    return True\n\n\ndef first_bday_after(day):\n    n = day + datetime.timedelta(days=1)\n    while not is_bday(n):\n        n += datetime.timedelta(days=1)\n    return n\n\n\ndef count_business_days_first_excluded(start, n):\n    \"\"\"art. 224 §1: EXCLUDE dia do comeco (start); count n business days after it.\"\"\"\n    seq = []\n    d = start\n    while len(seq) < n:\n        d += datetime.timedelta(days=1)\n        if is_bday(d):\n            seq.append(d)\n    return seq[-1], seq\n\n\n# ---------- CITACAO ----------\nc_pub = datetime.date(2026, 11, 19)          # quinta-feira (document)\nc_inicio = first_bday_after(c_pub)           # 1o util apuv. do pub (art. 224o3)\nprint(\"Confirmando dias da semana:\")\nprint(\"  \", wd(c_pub), \"= disponibilizacao/publicacao (art. 4o3 + 224o2)\")\nprint(\"  \", wd(c_inicio), \"= inicio da contagem (224o3 / 231VII)\")\nprint(\"  (dia seguinte 19/11:\", wd(datetime.date(2026, 11, 20)),\"= feriado Zumbi, por isso pula; 23/11 e utilize)\\n\")\nc_venc, c_seq = count_business_days_first_excluded(c_inicio, 15)\nprint(f\"CITACAO -> Contestacao (15 dias uteis, art. 335 III), inicio exclui dia 23/11:\")\nfor i, d in enumerate(c_seq, 1):\n    tag = \"  [Feriado]\" if d in FERIADOS or d in SEM_EXPEDIENTE else \"\"\n    print(f\"   {i:2d}. {wd(d)}{tag}\")\nprint(f\"   => VENCIMENTO contestacao = {wd(c_venc)}\")\n\n# ---------- SENTENCA ----------\ns_pub = datetime.date(2026, 12, 10)          # quinta-feira (document)\ns_inicio = first_bday_after(s_pub)\nprint(\"\\nSentenca disponibilidade 10/12 (quinta). Inicio da contagem (224o3):\")\nprint(\"  \", wd(s_inicio))\nemb_venc, emb_seq = count_business_days_first_excluded(s_inicio, 5)\nprint(f\"SENTENCA -> Embargos de Declaracao (5 dias uteis, art. 1.023):\")\nfor i, d in enumerate(emb_seq, 1):\n    print(f\"   {i:2d}. {wd(d)}\")\nprint(f\"   => VENCIMENTO embargos = {wd(emb_venc)}\")\n\nrec_venc, rec_seq = count_business_days_first_excluded(s_inicio, 15)\nprint(f\"\\nSENTENCA -> Recurso / Apelacao (15 dias uteis, art. 1.003 5) - ATRAVESSA recesso:\")\nfor i, d in enumerate(rec_seq, 1):\n    tag = \"  [RECESSAO 220]\" if RECESSAO_IN <= d <= RECESSAO_FIM else \"\"\n    print(f\"   {i:2d}. {wd(d)}{tag}\")\nprint(f\"   => VENCIMENTO recurso = {wd(rec_venc)}\")\n\n# ---------- Dobro (sensibilidade) ----------\nc2, _ = count_business_days_first_excluded(c_inicio, 30)\nr2, _ = count_business_days_first_excluded(s_inicio, 30)\nprint(\"\\nSensibilidade - prazo em DOBRO (art. 229 caput):\")\nprint(f\"  Contestacao em dobro (30 dias uteis) = {wd(c2)}\")\nprint(f\"  Recurso em dobro (30 dias uteis)      = 