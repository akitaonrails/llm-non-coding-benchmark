e** o prazo para a interposição de recurso (art. 1.026).\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /work/workspace \\u0026\\u0026 echo \\\"=== cpc_prazos_recursais.md ===\\\" \\u0026\\u0026 cat library/cpc_prazos_recursais.md\"}"},"time":{"start":1792714665798,"end":1792714665822}}}}
