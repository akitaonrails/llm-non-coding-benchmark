tacao (15 dias uteis, art. 335 III)\")\nprint(f\"  disponibilizacao / publicacao = {wd(c_pub)} (dia util)\")\nprint(f\"  inicio da contagem = {wd(c_inicio)} (1o util seguinte; pula 20/11 Zumbi)\\n\")\nc_venc, c_seq = count_business_days_first_excluded(c_inicio, 15)\nfor i, d in enumerate(c_seq, 1):\n    print(f\"  {i:2d}. {wd(d)}\")\nprint(f\"  => VENCIMENTO contestacao = {wd(c_venc)}\")\nc2, _ = count_business_days_first_excluded(c_inicio, 30)\nprint(f\"  (dobro 30 dias uteis, art. 229 caput) = {wd(c2)}\\n\")\n\n# ---------- SENTENCA: Embargos (5) e Recurso (15) ----------\ns_pub = datetime.date(2026, 12, 10)          # quinta-feira (document)\ns_inicio = first_bday_after(s_pub)\nprint(\"SENTENCA -> Embargos de Declaracao (5 dias uteis, art. 1.023)\")\nprint(f\"  disponibilizacao / publicacao = {wd(s_pub)} (dia util)\")\nprint(f\"  inicio da contagem = {wd(s_inicio)}\")\nemb_venc, emb_seq = count_business_days_first_excluded(s_inicio, 5)\nfor i, d in enumerate(emb_seq, 1):\n    print(f\"  {i:2d}. {wd(d)}\")\nprint(f\"  => VENCIMENTO embargos = {wd(emb_venc)}\\n\")\n\nprint(\"SENTENCA -> Recurso / Apellazione (15 dias uteis, art. 1.003, §5) - atravessa recesso:\")\nprint(f\"  inicio da contagem = {wd(s_inicio)}\")\nfor i, d in enumerate(*count_business_days_first_excluded(s_inicio, 15)):\n    tag = \"   [RECESSAO art.220]\" if RECESSAO_IN <= d <= RECESSAO_FIM else \"\"\n    print(f\"  {i:2d}. {wd(d)}{tag}\")\nrec_venc, rec_seq = count_business_days_first_excluded(s_inicio, 15)\nprint(f\"  => VENCIMENTO recurso = {wd(rec_venc)}\")\nr2, _ = count_business_days_first_excluded(s_inicio, 30)\nprint(f\"  (dobro 30 dias uteis) = {wd(r2)}\")\nPYEOF_MARKER_UNUSED = None\n"},"output":"Created file successfully: /tmp/calc5.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/calc5.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\":\"/tmp/calc5.py\",\"conte