{"type":"tool_use","timestamp":1792711318765,"sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","part":{"partID":"prt_165ebdce2001L3K0rNdTxaaydx","sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","messageID":"msg_165eb55810012SIIQ8OoRQ4SDL","type":"tool","id":"yt2AE9l1bRKwZ1unxxk31ndzoB5milsh","tool":"write","state":{"status":"completed","input":{"content":"import datetime\n\n# Calendar (from library/calendario_forense_campinas.md)\n# \"sem expediente forense\" days -> excluded, like a weekday\nNONBUS = set({\n    datetime.date(2026, 10, 24),  # (example) none; will populate real ones below\n    datetime.date(2026, 11, 20),  # Dia Nacional de Zumbi e Consciência Negra (Lei 14.759/2023)\n    datetime.date(2026, 11, 28),  # Dia do ServioPublico (sem expediente forense)\n    datetime.date(2026, 12, 24),  # sem expediente forense\n    datetime.date(2026, 12, 25),  # Natal\n    datetime.date(2026, 12, 31),  # sem expediente forense\n    datetime.date(2027, 1, 1),    # Confraternizacao Universal\n})\n# Recess / suspension (art. 220): 20/12/2026 .. 20/01/2027 inclusive\nRECESS = (datetime.date(2026, 12, 20), datetime.date(2027, 1, 20))\n\n\ndef is_bday(d):\n    return not (d.weekday() >= 5\n                or d in NONBUS\n                or RECESS[0] <= d <= RECESS[1])\n\n\ndef first_business_after(day):\n    n = day + datetime.timedelta(days=1)\n    while not is_bday(n):\n        n += datetime.timedelta(days=1)\n    return n\n\n\ndef add_bdays(start_exclusive, n):\n    d = start_exclusive\n    seq = []\n    while len(seq) < n:\n        d += datetime.timedelta(days=1)\n        if is_bday(d):\n            seq.append(d)\n    return d, seq\n\n\ndef wd(d):\n    return d.strftime(\"%A %d/%m/%Y\")\n\n\ndef run(label, dispon, prazo):\n    pub = dispon            # dispon already -> already a bday -> pub = dispon\n    inicio = first_business_after(pub)\n    venc, seq = add_bdays(inicio, prazo)\n    print(f\"=== {label} (prazo={prazo} dias uteis) ===\")\n    print(\"  disponibilidade:\", wd(dispon))\n    print(\"  publicacao (art. 4o3 / CPC 224 2):\", wd(pub))\n    print(\"  inicio contagem (art. 224o3 / 231VII):\", wd(inicio))\n    for x in seq:\n        r = \"  <RECESSO art.220>\" if (RECESS[0] <= x <= RECESS[1]) else (\"  <sem exp.>\" if x in NONBUS else \"\")\n        print(\"   \", wd(x), r)\n    print(\"  => VENCIMENTO:\", wd(venc))\n    print()\n\n\n# CITACAO -> contestacao\nrun(\"CITACAO -> contestacao (art. 335 III)\", datetime.date(2026, 11, 19), 15)\n# SENTENCA -> recurso\nrun(\"SENTENCA -> recurso (art. 1.003 5)\", datetime.date(2026, 12, 10), 15)\n# SENTENCA -> embargos opcional\nrun(\"SENTENCA -> embargos de decl. (art. 1.023)\", datetime.date(2026, 12, 10), 5)\n","path":"/tmp/calc.py"},"output":"Wrote file successfully: /tmp/calc.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: /tmp/calc.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import datetime\\n\\n# Calendar (from library/calendario_forense_campinas.md)\\n# \\\"sem expediente forense\\\" days -\\u003e excluded, like a weekday\\nNONBUS = set({\\n    datetime.date(2026, 10, 24),  # (example) none; will populate real ones below\\n    datetime.date(2026, 11, 20),  # Dia Nacional de Zumbi e Consciência Negra (Lei 14.759/2023)\\n    datetime.date(2026, 11, 28),  # Dia do ServioPublico (sem expediente forense)\\n    datetime.date(2026, 12, 24),  # sem expediente forense\\n    datetime.date(2026, 12, 25),  # Natal\\n    datetime.date(2026, 12, 31),  # sem expediente forense\\n    datetime.date(2027, 1, 1),    # Confraternizacao Universal\\n})\\n# Recess / suspension (art. 220): 20/12/2026 .. 20/01/2027 inclusive\\nRECESS = (datetime.date(2026, 12, 20), datetime.date(2027, 1, 20))\\n\\n\\ndef is_bday(d):\\n    return not (d.weekday() \\u003e= 5\\n                or d in NONBUS\\n                or RECESS[0] \\u003c= d \\u003c= RECESS[1])\\n\\n\\ndef first_business_after(day):\\n    n = day + datetime.timedelta(days=1)\\n    while not is_bday(n):\\n        n += datetime.timedelta(days=1)\\n    return n\\n\\n\\ndef add_bdays(start_exclusive, n):\\n    d = start_exclusive\\n    seq = []\\n    while len(seq) \\u003c n:\\n        d += datetime.timedelta(days=1)\\n        if is_bday(d):\\n            seq.append(d)\\n    return d, seq\\n\\n\\ndef wd(d):\\n    return d.strftime(\\\"%A %d/%m/%Y\\\")\\n\\n\\ndef run(label, dispon, prazo):\\n    pub = dispon            # dispon already -\\u003e already a bday -\\u003e pub = dispon\\n    inicio = first_business_after(pub)\\n    venc, seq = add_bdays(inicio, prazo)\\n    print(f\\\"=== {label} (prazo={prazo} dias uteis) ===\\\")\\n    print(\\\"  disponibilidade:\\\", wd(dispon))\\n    print(\\\"  publicacao (art. 4o3 / CPC 224 2):\\\", wd(pub))\\n    print(\\\"  inicio contagem (art. 224o3 / 231VII):\\\", wd(inicio))\\n    for x in seq:\\n        r = \\\"  \\u003cRECESSO art.220\\u003e\\\" if (RECESS[0] \\u003c= x \\u003c= RECESS[1]) else (\\\"  \\u003csem exp.\\u003e\\\" if x in NONBUS else \\\"\\\")\\n        print(\\\"   \\\", wd(x), r)\\n    print(\\\"  =\\u003e VENCIMENTO:\\\", wd(venc))\\n    print()\\n\\n\\n# CITACAO -\\u003e contestacao\\nrun(\\\"CITACAO -\\u003e contestacao (art. 335 III)\\\", datetime.date(2026, 11, 19), 15)\\n# SENTENCA -\\u003e recurso\\nrun(\\\"SENTENCA -\\u003e recurso (art. 1.003 5)\\\", datetime.date(2026, 12, 10), 15)\\n# SENTENCA -\\u003e embargos opcional\\nrun(\\\"SENTENCA -\\u003e embargos de decl. (art. 1.023)\\\", datetime.date(2026, 12, 10), 5)\\n\",\"path\":\"/tmp/calc.py\"}"},"time":{"start":1792711318754,"end":1792711318765}}}}
