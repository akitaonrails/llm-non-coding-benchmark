{"type":"tool_use","timestamp":1792711630574,"sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","part":{"partID":"prt_165f09edf001u9nb2bNwvgXidS","sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","messageID":"msg_165f02c03001yiT01xauJ3gEqj","type":"tool","id":"22H6tnD9B7gtfcDnorxeqz8nxva6nb0j","tool":"write","state":{"status":"completed","input":{"content":"import datetime\nNONBUS = set({\n    datetime.date(2026, 10, 24),\n    datetime.date(2026, 11, 20),\n    datetime.date(2026, 11, 28),\n    datetime.date(2026, 12, 24),\n    datetime.date(2026, 12, 25),\n    datetime.date(2026, 12, 31),\n    datetime.date(2027, 1, 1),\n})\nRECESS = (datetime.date(2026, 12, 20), datetime.date(2027, 1, 20))\ndef is_bday(d):\n    return not (d.weekday() >= 5 or d in NONBUS or RECESS[0] <= d <= RECESS[1])\ndef first_bday_after(day):\n    n = day + datetime.timedelta(days=1)\n    while not is_bday(n):\n        n += datetime.timedelta(days=1)\n    return n\ndef add_bdays(start_exclusive, n):\n    d = start_exclusive; seq = []\n    while len(seq) < n:\n        d += datetime.timedelta(days=1)\n        if is_bday(d): seq.append(d)\n    return d, seq\ndef wd(d): return d.strftime(\"%d/%m/%Y %A\")\n\n# CITACAO\ncit_pub = datetime.date(2026, 11, 19)\ncit_inicio = first_bday_after(cit_pub)   # 20/11\nv_cit, seq = add_bdays(cit_inicio, 15)\nprint(\"CITACAO -> contestacao (15 dias uteis); pub 19/11; inicio 20/11 (224o3/231VII); 229 caput -> DOBRO: 30 dias uteis -> \", wd(v_cit))\n\n# SENTENCA\nsent_pub = datetime.date(2026, 12, 10)\nsent_inicio = first_bday_after(sent_pub)  # 21/12\nv_sent, seq = add_bdays(sent_inicio, 15)\nprint(\"SENTENCA -> recurso (15 dias uteis); inicio 21/12; -> \", wd(v_sent))\nv_emb, seq = add_bdays(sent_inicio, 5)\nprint(\"SENTENCA -> embargos (5 dias uteis); -> \", wd(v_emb))\n\n# DOBRO\nprint(\"CITACAO em DOBRO (30 dias uteis -> contestacao):\", wd(add_bdays(cit_inicio, 30)[0]))\nprint(\"SENTENCA apelacao em DOBRO (30 dias uteis -> recurso):\", wd(add_bdays(sent_inicio, 30)[0]))\nEOF","path":"/tmp/calc2.py"},"output":"Created file successfully: /tmp/calc2.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/calc2.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import datetime\\nNONBUS = set({\\n    datetime.date(2026, 10, 24),\\n    datetime.date(2026, 11, 20),\\n    datetime.date(2026, 11, 28),\\n    datetime.date(2026, 12, 24),\\n    datetime.date(2026, 12, 25),\\n    datetime.date(2026, 12, 31),\\n    datetime.date(2027, 1, 1),\\n})\\nRECESS = (datetime.date(2026, 12, 20), datetime.date(2027, 1, 20))\\ndef is_bday(d):\\n    return not (d.weekday() \\u003e= 5 or d in NONBUS or RECESS[0] \\u003c= d \\u003c= RECESS[1])\\ndef first_bday_after(day):\\n    n = day + datetime.timedelta(days=1)\\n    while not is_bday(n):\\n        n += datetime.timedelta(days=1)\\n    return n\\ndef add_bdays(start_exclusive, n):\\n    d = start_exclusive; seq = []\\n    while len(seq) \\u003c n:\\n        d += datetime.timedelta(days=1)\\n        if is_bday(d): seq.append(d)\\n    return d, seq\\ndef wd(d): return d.strftime(\\\"%d/%m/%Y %A\\\")\\n\\n# CITACAO\\ncit_pub = datetime.date(2026, 11, 19)\\ncit_inicio = first_bday_after(cit_pub)   # 20/11\\nv_cit, seq = add_bdays(cit_inicio, 15)\\nprint(\\\"CITACAO -\\u003e contestacao (15 dias uteis); pub 19/11; inicio 20/11 (224o3/231VII); 229 caput -\\u003e DOBRO: 30 dias uteis -\\u003e \\\", wd(v_cit))\\n\\n# SENTENCA\\nsent_pub = datetime.date(2026, 12, 10)\\nsent_inicio = first_bday_after(sent_pub)  # 21/12\\nv_sent, seq = add_bdays(sent_inicio, 15)\\nprint(\\\"SENTENCA -\\u003e recurso (15 dias uteis); inicio 21/12; -\\u003e \\\", wd(v_sent))\\nv_emb, seq = add_bdays(sent_inicio, 5)\\nprint(\\\"SENTENCA -\\u003e embargos (5 dias uteis); -\\u003e \\\", wd(v_emb))\\n\\n# DOBRO\\nprint(\\\"CITACAO em DOBRO (30 dias uteis -\\u003e contestacao):\\\", wd(add_bdays(cit_inicio, 30)[0]))\\nprint(\\\"SENTENCA apelacao em DOBRO (30 dias uteis -\\u003e recurso):\\\", wd(add_bdays(sent_inicio, 30)[0]))\\nEOF\",\"path\":\"/tmp/calc2.py\"}"},"time":{"start":1792711630559,"end":1792711630574}}}}
