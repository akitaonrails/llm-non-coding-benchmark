rn f\"{parts[-1] if len(parts)==3 else parts[1]}\"\n110:     for r in range(5):\n111:         cells = [f\"{r*3+t+1} {wd(s[r*3+t])}\" for t in range(3)]\n112:         w(\"| \" + \" | \".join(cells) + \" |\")\n113:     w(\"\")\n114: \n115: # --- 3 ---\n116: w(\"## 3. Contagem — CITIAO → Contestação (15 dias úteis; art. 335 III)\\n\")\n117: w(f\"**Publicação 4º §3º + art. 224 §2º:** disponibilidade {wd(pub_cit)} é dia útil ⇒ **publicação = {wd(pub_cit)}**.\")\n118: w(\"\")\n119: w(f\"**Início da contagem 4º §4º + art. 224 §3º + art. 231 VII:** o 1º útil seguinte é 20/11, que é **Dia Nacional de Zumbi** (Lei 14.759/2023) ⇒ protraito para **{wd(ini_cit)}**.\")\n120: w(\"\")\n121: w(\"**Prazo:** 15 dias úteis (art. 335, III).\")\n122: w(\"\")\n123: three_col(cit_s, 15)\n124: w(\"- Pulam-se 21–22/11 e 05–06/12 (fim de semana); entre eles não há feriado nem recessão, logo contam-se os dias úteis de 24/11 a 14/12 — totalizando 15.\")\n125: w(\"- Nota: **08/12/2026 (terça-feira)** é feriado municipal de Campinas (N. Sra. da Conceição); no intervalo 24/11→14/12 não se conta como dia útil para a contestação do cliente.\")\n126: w(f\"- **Vencimento da Contação (prazo simples): {wd(c_simp)} (segunda-feira).**\\n\")\n127: w(\"---\\n\")\n128: \n129: # --- 4 ---\n130: w(\"## 4. Contagem — SENTENÇA (arguentos e recurso)\\n\")\n131: w(f\"**Publicação:** disponibilidade {wd(pub_sent)} = dia útil ⇒ publicação = {wd(pub_sent)}.\")\n132: w(f\"**Início da contagem:** 1º útil seguinte ⇒ **{wd(ini_sent)}**.\\n\")\n133: \n134: w(\"### 4a. Embargos de declaração — 5 dias úteis (art. 1.023)\\n\")\n135: w(\"| Nº | Útil |\")\n136: w(\"---|---|\")\n137: emb_s = seq(ini_sent, 5)\n138: for i, d in enumerate(emb_s, 1):\n139:     w(f\"{i} | {wd(d)}\")\n140: w(\"\")\n141: w(f\"- **Vencimento dos Embargos: {wd(e_simp)}**. Não incide ainda o recessão (inicia 20/12).\")\n142: w(f\"- A oposição de embargos interrompe o prazo do recurso (art. 1.026), reiniciando a contagem após o trânsito julgado. Não alter