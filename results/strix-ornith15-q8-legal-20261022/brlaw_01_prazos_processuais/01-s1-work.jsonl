count_from(datetime.date(2026,12,10),5)))\nEOF"},"output":"CITACAO 19/11/2026 (Thu), contestacao 15dias\n  (A) inicio=next bday:  11/12(Fri[:3]) -> 11/12(Fri[:3])\n  (B) inicio=pub(231VII) inclusive: 10/12(Thu[:3])\n\nSENTENCA 10/12/2026 (Thu), recurso 15dias\n  (A) inicio=next bday:   02/02(Tue[:3])\n  (B) inicio=pub(231VII) inclusive: 01/02(Mon[:3])\n\nSENTENCA 10/12/2026 (Thu), embargos 5dias\n  (A) inicio=next bday:   17/12(Thu[:3])\n  (B) inicio=pub(231VII) inclusive: 16/12(Wed[:3])\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"CITACAO 19/11/2026 (Thu), contestacao 15dias\n  (A) inicio=next bday:  11/12(Fri[:3]) -> 11/12(Fri[:3])\n  (B) inicio=pub(231VII) inclusive: 10/12(Thu[:3])\n\nSENTENCA 10/12/2026 (Thu), recurso 15dias\n  (A) inicio=next bday:   02/02(Tue[:3])\n  (B) inicio=pub(231VII) inclusive: 01/02(Mon[:3])\n\nSENTENCA 10/12/2026 (Thu), embargos 5dias\n  (A) inicio=next bday:   17/12(Thu[:3])\n  (B) inicio=pub(231VII) inclusive: 16/12(Wed[:3])\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\":\"cd /tmp \\u0026\\u0026 python3 \\u003c\\u003c 'EOF'\\nimport datetime\\nNONBUS=set({datetime.date(2026,1,1),datetime.date(2026,11,20),datetime.date(2026,11,28),\\n            datetime.date(2026,12,24),datetime.date(2026,12,25),datetime.date(2026,12,31),\\n            datetime.date(2027,1,1)})\\nRECESS=(datetime.date(2026,12,20),datetime.date(2027,1,20))\\ndef is_b(d): return not(d.weekday()\\u003e=5 or d in NONBUS or RECESS[0]\\u003c=d\\u003c=RECESS[1])\\ndef wd(d):return f\\\"{d:%d/%m}({d:%a[:3]})\\\"\\ndef first_after(day):\\n    n=day+datetime.timedelta(days=1)\\n    while not is_b(n): n+=datetime.timedelta(days=1)\\n    return n\\ndef count_from(start,n):  # first counted = start (inclusive), skip non-bdays\\n    seq=[]; d=start\\n    while len(seq)\\u003cn:\\n        if is_b(d): seq.append(d)\\n        d+=datetime.timedelta(days