 = add_bdays(sent_inicio, 15)\n\nprint(\"=== SENTENCA -> recurso (art. 1.003 5 = 15 dias uteis) ===\")\nprint(\"publicacao:\", wd(sent_pub))\nprint(\"inicio contagem:\", wd(sent_inicio))\nfor x in seq_sent:\n    tag = \"\"\n    if RECESS[0] <= x <= RECESS[1]:\n        tag = \"  (dentro do RECESSO art. 220)\"\n    if x in NONBUS:\n        tag = \"  (sem expediente)\"\n    print(\"  \" + wd(x) + tag)\nprint(\"VENCIMENTO =\", wd(v_sent))\nprint()\n\n# ===== Sentenca -> embargos 5 dias uteis (opcional) =====\nv_emb, seq_emb = add_bdays(sent_inicio, 5)\nprint(\"=== SENTENCA -> embargos (art. 1.023 = 5 dias uteis) ===\")\nprint(\"contagem:\", [wd(x) for x in seq_emb])\nprint(\"VENCIMENTO =\", wd(v_emb))\n","path":"/tmp/calc.py"},"output":"Wrote file successfully: /tmp/calc.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Wrote file successfully: /tmp/calc.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\":\"import datetime\\n\\ndef wd(d):\\n    return d.strftime(\\\"%A %d/%m/%Y\\\")\\n\\nNONBUS = {\\n    datetime.date(2026, 10, 28),  # dia do ServidoPublico — sem expediente forense\\n    datetime.date(2026, 12, 24),  # sem expediente forense\\n    datetime.date(2026, 12, 31),  # sem expediente forense\\n}\\nRECESS = (datetime.date(2026, 12, 20), datetime.date(2027, 1, 20))  # inclusive\\n\\n\\ndef is_bday(d):\\n    return not (d.weekday() \\u003e= 5\\n                or d in NONBUS\\n                or RECESS[0] \\u003c= d \\u003c= RECESS[1])\\n\\n\\ndef first_business_after(day):\\n    n = day + datetime.timedelta(days=1)\\n    while not is_bday(n):\\n        n += datetime.timedelta(days=1)\\n    return n\\n\\n\\ndef add_bdays(start_exclusive, n):\\n    d = start_exclusive\\n    seq = []\\n    while len(seq) \\u003c n:\\n        d += datetime.timedelta(days=1)\\n        if is_bday(d):\\n            seq.append(d)\\n    return d, seq\\n\\n\\n# ===== CITACAO -\\u003e contestaca