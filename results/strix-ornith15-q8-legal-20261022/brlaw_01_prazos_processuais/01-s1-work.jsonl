{"type":"tool_use","timestamp":1792710482478,"sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","part":{"partID":"prt_165df1a14001ySiUxkr6E77QwP","sessionID":"ses_e9a22f168ffeMitJv1wz5wxyzc","messageID":"msg_165dda9d6001SfTB1b4pU1CxQc","type":"tool","id":"ucp9gWcbFmrIxlBcwj0aT3YEguuiEG0g","tool":"shell","state":{"status":"completed","input":{"command":"python3 << 'EOF'\nimport datetime\n\ndef weekday(d):\n    return d.strftime(\"%A\")\n\ndef add_business_days(start, n):\n    \"\"\"Add n business days to start (exclusive of a weekend/holiday). start is expected to be a business day.\"\"\"\n    holidays_bday = {\n        datetime.date(2026,11,28),  # Servidor Público (sem expediente forense)\n        datetime.date(2026,12,24),  # sem expediente forense\n        datetime.date(2026,12,31),  # sem expediente forense\n    }\n    d = start\n    added = 0\n    while added < n:\n        d += datetime.timedelta(days=1)\n        # skip Saturdays/Sundays\n        if d.weekday() >= 5:\n            continue\n        if d in holidays_bday:\n            continue\n        # skip recess\n        between = datetime.date(2026,12,20) <= d <= datetime.date(2027,1,20)\n        if between:\n            continue\n        added += 1\n    return d\n\ndef protract_if_nonbday(d, holidays_bday):\n    \"\"\"Article 224 §1 / 231: if start day is a day where forense is closed, move to first business day following.\"\"\"\n    while True:\n        if d.weekday() >= 5 or d in holidays_bday:\n            d += datetime.timedelta(days=1)\n            continue\n        if datetime.date(2026,12,20) <= d <= datetime.date(2027,1,20):\n            d += datetime.timedelta(days=1)\n            continue\n        return d\n\nprint(\"Key calendar facts:\")\nfor dt in [datetime.date(2026,10,19), datetime.date(2026,10,21), datetime.date(2026,10,28),\n           datetime.date(2026,11,5), datetime.date(2026,12,10), datetime.date(2026,12,17),\n           datetime.date(2026,12,21), datetime.date(2026,12,25), datetime.date(2026,12,28),\n           datetime.date(2027,1,6), datetime.date(2027,1,8)]:\n    print(f\"  {dt.isoformat()} -> {weekday(dt)}\")\nprint()\n\ndef nonbday(d):\n    return d.weekday()>=5 or d in {\n        datetime.date(2026,11,28), datetime.date(2026,12,24), datetime.date(2026,12,31),\n        datetime.date(2026,12,25), datetime.date(2026,10,19), datetime.date(2026,10,25),\n        datetime.date(2026,10,24), datetime.date(2026,10,23)}\n\n# ---- CITACAO: contestação ----\npub = datetime.date(2026,10,19)\nstart_optA = pub          # literal 231: start = publication date (19th)\nstart_optB = protract_if_nonbday(pub, {datetime.date(2026,11,28),datetime.date(2026,12,24),datetime.date(2026,12,31)})\nprint(\"CITACAO -> contestação (15 dias úteis):\")\nprint(\"  start(A, literal 19/10):\", start_optA.isoformat(), weekday(start_optA))\nprint(\"  start(B, protracted 21/10):\", start_optB.isoformat(), weekday(start_optB))\nprint(\"  vencimento A:\", add_business_days(start_optA,15).isoformat(), weekday(add_business_days(start_optA,15)))\nprint(\"  vencimento B:\", add_business_days(start_optB,15).isoformat(), weekday(add_business_days(start_optB,15)))\nprint()\n\n# ---- SENTENCA: embargos de declaração (5 dias úteis) ----\npub2 = datetime.date(2026,12,10)\nstart2 = protract_if_nonbday(pub2,{datetime.date(2026,11,28),datetime.date(2026,12,24),datetime.date(2026,12,31)})\nemb = add_business_days(start2,5)\nprint(\"SENTENCA -> embargos (5 dias úteis):\")\nprint(\"  pub:\", pub2.isoformat(), weekday(pub2), \"start:\", start2.isoformat())\nprint(\"  vencimento embargos:\", emb.isoformat(), weekday(emb))\nprint()\n\n# ---- SENTENCA: apelação (15 dias úteis) ----\nstart3 = protract_if_nonbday(pub2,{datetime.date(2026,11,28),datetime.date(2026,12,24),datetime.date(2026,12,31)})\napel = add_business_days(start3,15)\nprint(\"SENTENCA -> apelação (15 dias úteis):\")\nprint(\"  start:\", start3.isoformat(), \"vencimento:\", apel.isoformat(), weekday(apel))\n# protract vencimento if nonbday\nbdays = {datetime.date(2026,11,28),datetime.date(2026,12,24),datetime.date(2026,12,31)}\nwhile nonbday(apel) or (datetime.date(2026,12,20) <= apel <= datetime.date(2027,1,20)):\n    apel = add_business_days(apel,1)\nprint(\"  vencimento (protraido):\", apel.isoformat(), weekday(apel))\nprint()\n\nprint(\"--- Dias suspensos ou feriados (sentença contagem) ---\")\nprint(\"Recesso 20/12/2026 a 20/01/2027 (CPC art. 220): inclusive para a contagem de apelação\")\nprint(\"Feriados na janela: 25/12 (Natal), 01/01/2027 (Confraternização)\")\nEOF"},"output":"Key calendar facts:\n  2026-10-19 -> Monday\n  2026-10-21 -> Wednesday\n  2026-10-28 -> Wednesday\n  2026-11-05 -> Thursday\n  2026-12-10 -> Thursday\n  2026-12-17 -> Thursday\n  2026-12-21 -> Monday\n  2026-12-25 -> Friday\n  2026-12-28 -> Monday\n  2027-01-06 -> Wednesday\n  2027-01-08 -> Friday\n\nCITACAO -> contestação (15 dias úteis):\n  start(A, literal 19/10): 2026-10-19 Monday\n  start(B, protracted 21/10): 2026-10-19 Monday\n  vencimento A: 2026-11-09 Monday\n  vencimento B: 2026-11-09 Monday\n\nSENTENCA -> embargos (5 dias úteis):\n  pub: 2026-12-10 Thursday start: 2026-12-10\n  vencimento embargos: 2026-12-17 Thursday\n\nSENTENCA -> apelação (15 dias úteis):\n  start: 2026-12-10 vencimento: 2027-02-02 Tuesday\n  vencimento (protraido): 2027-02-02 Tuesday\n\n--- Dias suspensos ou feriados (sentença contagem) ---\nRecesso 20/12/2026 a 20/01/2027 (CPC art. 220): inclusive para a contagem de apelação\nFeriados na janela: 25/12 (Natal), 01/01/2027 (Confraternização)\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"Key calendar facts:\n  2026-10-19 -> Monday\n  2026-10-21 -> Wednesday\n  2026-10-28 -> Wednesday\n  2026-11-05 -> Thursday\n  2026-12-10 -> Thursday\n  2026-12-17 -> Thursday\n  2026-12-21 -> Monday\n  2026-12-25 -> Friday\n  2026-12-28 -> Monday\n  2027-01-06 -> Wednesday\n  2027-01-08 -> Friday\n\nCITACAO -> contestação (15 dias